FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=

# OpenAI for both the agents and the embeddings. One key covers both.
LLM_PROVIDER=openai
LLM_API_KEY=
# Strong model: Investigator + Remediator. Fast model: Triage + Scribe. Check these names against your account.
MODEL_STRONG=gpt-4.1
MODEL_FAST=gpt-4.1-mini
# text-embedding-3-small returns 1536 dims; EMBED_DIM must match the vector index.
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

DEMO_TENANT_KEY=
RATE_LIMIT_PER_HOUR=10
MAX_TOKENS_PER_INCIDENT=60000
